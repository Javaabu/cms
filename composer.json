{
    "name": "javaabu/cms",
    "description": "A complete CMS for Laravel assembled from Javaabu packages: pages, news, categories and tags (javaabu/post-types), menus (javaabu/dynamic-menubuilder), widgets (javaabu/widgets), site settings, a media library, an admin dashboard and navigation, an install command and a default public theme, in Blade and Inertia React",
    "homepage": "https://github.com/Javaabu/cms",
    "license": "MIT",
    "keywords": [
        "javaabu",
        "laravel",
        "cms",
        "post-types",
        "pages",
        "news",
        "menus",
        "widgets",
        "blade",
        "inertia",
        "react",
        "dhivehi"
    ],
    "authors": [
        {
            "name": "Javaabu Pvt. Ltd.",
            "email": "info@javaabu.com",
            "homepage": "https://javaabu.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "javaabu/block-editor": "^1.0@dev",
        "javaabu/dynamic-menubuilder": "^1.0@dev",
        "javaabu/forms": "^2.0@dev",
        "javaabu/manifest": "^1.0@dev",
        "javaabu/mediapicker": "^1.0@dev",
        "javaabu/permissions": "^3.0@dev",
        "javaabu/post-types": "^1.0@dev",
        "javaabu/settings": "^2.0@dev",
        "javaabu/stencil": "^1.0@dev",
        "javaabu/widgets": "^1.0@dev"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^2.0",
        "javaabu/boost-javaabu-guidelines": "^1.4",
        "javaabu/translatable": "^3.0@dev",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.3 || ^12.5.8"
    },
    "suggest": {
        "inertiajs/inertia-laravel": "Renders the admin and public pages with Inertia React when cms.views is inertia (^2.0)",
        "javaabu/translatable": "Pages, news, terms, menus, widgets and site settings in several languages (^3.0)"
    },
    "autoload": {
        "psr-4": {
            "Javaabu\\Cms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Javaabu\\Cms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-clover=clover.xml",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "branch-alias": {
            "dev-next-gen": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "Javaabu\\Cms\\CmsServiceProvider"
            ],
            "aliases": {
                "Cms": "Javaabu\\Cms\\Facades\\Cms"
            }
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/block-editor"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/bulk-actions"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/filters"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/forms"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/manifest"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/meta"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/permissions"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/post-types"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/stencil"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/widgets"
        },
        {
            "type": "vcs",
            "url": "https://github.com/n4ff4h/dynamic-menubuilder"
        },
        {
            "type": "vcs",
            "url": "https://github.com/n4ff4h/mediapicker"
        },
        {
            "type": "vcs",
            "url": "https://github.com/n4ff4h/settings"
        },
        {
            "type": "vcs",
            "url": "https://github.com/n4ff4h/translatable"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
